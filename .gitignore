# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ---- 虚拟环境 ----
.venv/
venv/
env/
.python-version

# ---- 工具缓存 ----
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 工具在仓库根目录留下的临时目录（当 TEMP 指向当前目录时会出现）
pip-*/
pytest-of-*/

