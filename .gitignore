# ---------------------------------------------------------------------------
# 这里只忽略「运行时生成」或「编辑器/工具产生」的东西；源码与文档一律入库。
# 每条都注明来源，方便以后增删时判断是否仍然需要。
# 注意：gitignore 不支持行内注释，注释必须独占一行。
# ---------------------------------------------------------------------------

# ---- Python 编译产物 ----
__pycache__/
*.py[cod]

# ---- 虚拟环境 ----
.venv/
venv/
env/
.python-version

# ---- 测试与静态检查工具的缓存与临时目录 ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
# pip 与 pytest 在仓库根目录留下的临时目录（当 TEMP 指向当前目录时会出现）
pip-*/
pytest-of-*/

# ---- 缓存挑选器的运行时产物（cache_picker.py / cache_source.py）----
# 缩略图缓存：可删，重建约 15 秒
cache_thumbs/
# 缓存索引：删掉后下次会重新解密全部缓存
cache_index.json
# 视频抽帧临时目录（抽帧完即删）
tmp_video/
# 记住上次的 tdata 路径与偏好
cache_config.json

# ---- 语言偏好（两个工具共享）----
language.json

# ---- 在线挑选器的凭据与会话（tg_picker.py）—— 绝对不要外传 ----
# api_id / api_hash / 手机号
config.json
# Telethon 登录会话及其 SQLite 日志
*.session
*.session-journal

# ---- 挑选/下载出来的媒体 ----
# 在线挑选器的默认输出目录
downloads/
# 缓存挑选器的默认输出目录（中文界面 / 英文界面）
挑选保存/
picked/
tg-scoop-output/

# ---- 日志（任何工具都可能生成）----
*.log
# 无控制台启动时的报错日志目录（两个工具各一份）
logs/

# ---- 打包 / 构建产物（PyInstaller 等生成的发布包，不入库）----
dist/
build/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# ---- 工具/代理工作区（方案稿等中间产物）----
.trae/