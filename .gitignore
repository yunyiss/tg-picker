cache_thumbs/
preview/
tmp_video/
cache_index.json

# ---- 自检/测试的输出日志 ----
_smoketest_*.txt
_smoketest_*.log
*.log

# ---- 本地配置（可能含路径，甚至 api 凭据）----
cache_config.json
# 语言偏好（两个工具共享）
language.json

# ---- 登录会话与密钥：绝对不进版本库 ----
*.session
*.session-journal
config.json
key_*

# ---- 下载/挑选出来的媒体 ----
downloads/
挑选保存/
picked/
tg-scoop-output/

